diff --git a/Core/Utils/LinuxCudaRuntime.cs b/Core/Utils/LinuxCudaRuntime.cs
new file mode 100644
index 000000000..249edd0d2
--- /dev/null
+++ b/Core/Utils/LinuxCudaRuntime.cs
@@ -0,0 +1,127 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Runtime.InteropServices;
+
+namespace T3.Core.Utils;
+
+/// <summary>Linux only: checks that the CUDA runtime the ONNX Runtime GPU build links against can be loaded,
+/// before the CUDA execution provider is appended. Without it the provider fails inside native code
+/// ("libcublasLt.so.12: cannot open shared object file") and ONNX Runtime prints the error to stderr;
+/// probing first lets the operator skip CUDA with one readable line and go on to the CPU provider.
+/// <para>Libraries are looked up through ld.so first, then in the usual toolkit folders, a
+/// <c>CudaRuntime</c> folder next to the operator, and <c>CUDA_PATH</c>/<c>CUDA_HOME</c>. Loaded by absolute path
+/// they stay resident, and the provider's own imports are then satisfied by SONAME without
+/// <c>LD_LIBRARY_PATH</c> having to be set.</para></summary>
+public static class LinuxCudaRuntime
+{
+    /** What libonnxruntime_providers_cuda.so of the 1.24 GPU package links against, plus cuDNN. */
+    private static readonly string[] RequiredLibraries =
+    {
+        "libcudart.so.12", "libcublasLt.so.12", "libcublas.so.12", "libcurand.so.10", "libcufft.so.11", "libcudnn.so.9"
+    };
+
+    private static readonly object Lock = new();
+    private static readonly List<IntPtr> LoadedHandles = new();
+    private static string? _failure;
+    private static bool _probed;
+
+    public static bool TryPrepare(out string reason)
+    {
+        lock (Lock)
+        {
+            if (!_probed)
+            {
+                _probed = true;
+                _failure = Probe();
+            }
+
+            reason = _failure ?? string.Empty;
+            return _failure == null;
+        }
+    }
+
+    private static string? Probe()
+    {
+        var searchDirs = CollectSearchDirs();
+        var missing = new List<string>();
+
+        foreach (var library in RequiredLibraries)
+        {
+            if (!TryLoad(library, searchDirs))
+                missing.Add(library);
+        }
+
+        if (missing.Count == 0)
+            return null;
+
+        return $"{string.Join(", ", missing)} not found. The ONNX Runtime GPU build needs the CUDA 12 runtime and cuDNN 9 " +
+               "(NVIDIA driver 525 or newer, Pascal or newer GPU). Install them, or point CUDA_PATH at the toolkit";
+    }
+
+    private static bool TryLoad(string library, List<string> searchDirs)
+    {
+        if (NativeLibrary.TryLoad(library, out var handle))
+        {
+            LoadedHandles.Add(handle);
+            return true;
+        }
+
+        foreach (var dir in searchDirs)
+        {
+            var path = Path.Combine(dir, library);
+            if (File.Exists(path) && NativeLibrary.TryLoad(path, out handle))
+            {
+                LoadedHandles.Add(handle);
+                return true;
+            }
+        }
+
+        return false;
+    }
+
+    private static List<string> CollectSearchDirs()
+    {
+        var dirs = new List<string>();
+
+        void Add(string? dir)
+        {
+            if (!string.IsNullOrEmpty(dir) && Directory.Exists(dir) && !dirs.Contains(dir))
+                dirs.Add(dir);
+        }
+
+        var assemblyDir = Path.GetDirectoryName(typeof(LinuxCudaRuntime).Assembly.Location);
+        Add(Path.Combine(AppContext.BaseDirectory, "CudaRuntime"));
+        if (!string.IsNullOrEmpty(assemblyDir))
+            Add(Path.Combine(assemblyDir, "CudaRuntime"));
+
+        foreach (var variable in new[] { "CUDA_PATH", "CUDA_HOME" })
+        {
+            var root = Environment.GetEnvironmentVariable(variable);
+            if (string.IsNullOrEmpty(root))
+                continue;
+
+            Add(Path.Combine(root, "lib64"));
+            Add(Path.Combine(root, "lib"));
+            Add(Path.Combine(root, "targets", "x86_64-linux", "lib"));
+        }
+
+        // Toolkit installs: NVIDIA's runfile/deb (/usr/local/cuda-12.x), Arch (/opt/cuda), distro packages
+        var roots = new List<string> { "/usr/local/cuda", "/opt/cuda" };
+        if (Directory.Exists("/usr/local"))
+        {
+            roots.AddRange(Directory.GetDirectories("/usr/local", "cuda-12*").OrderByDescending(d => d, StringComparer.Ordinal));
+        }
+
+        foreach (var root in roots)
+        {
+            Add(Path.Combine(root, "lib64"));
+            Add(Path.Combine(root, "targets", "x86_64-linux", "lib"));
+        }
+
+        Add("/usr/lib/x86_64-linux-gnu");
+        Add("/usr/lib64");
+        return dirs;
+    }
+}
diff --git a/Core/Utils/OnnxNativeSelector.cs b/Core/Utils/OnnxNativeSelector.cs
new file mode 100644
index 000000000..b2711d69b
--- /dev/null
+++ b/Core/Utils/OnnxNativeSelector.cs
@@ -0,0 +1,89 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Reflection;
+using System.Runtime.InteropServices;
+using T3.Core.Logging;
+
+namespace T3.Core.Utils;
+
+/// <summary>
+/// Windows ships two ONNX Runtime natives with identical file names: the GPU build (CUDA, TensorRT) in
+/// <c>runtimes/win-x64/native</c> and the DirectML build in <c>runtimes/win-x64-directml/native</c>. A process can bind
+/// only one of them per managed ONNX Runtime assembly, so the first <see cref="Select"/> for an assembly decides, and the
+/// other provider family then needs a restart. Call it before the first ONNX Runtime type is used (a native call).
+/// On Linux and macOS there is nothing to choose and the call does nothing.
+/// </summary>
+public static class OnnxNativeSelector
+{
+    public enum Build
+    {
+        /// <summary>The GPU build: CUDA and TensorRT providers on Windows and Linux, CoreML on macOS.</summary>
+        Gpu,
+        DirectMl,
+    }
+
+    private const string GpuFolder = "runtimes/win-x64/native";
+    private const string DirectMlFolder = "runtimes/win-x64-directml/native";
+
+    private static readonly object Lock = new();
+    private static readonly Dictionary<Assembly, Build> Selected = new();
+
+    /// <summary>Binds the native for <paramref name="ortAssembly"/> (the Microsoft.ML.OnnxRuntime assembly of the calling
+    /// operator package) on first use and returns the build in effect, which differs from
+    /// <paramref name="preferred"/> when the other one was bound earlier or its files are not shipped.</summary>
+    public static Build Select(Assembly ortAssembly, Build preferred)
+    {
+        if (!OperatingSystem.IsWindows())
+            return Build.Gpu;
+
+        lock (Lock)
+        {
+            if (Selected.TryGetValue(ortAssembly, out var existing))
+                return existing;
+
+            var assemblyDir = Path.GetDirectoryName(ortAssembly.Location) ?? AppContext.BaseDirectory;
+            var chosen = preferred;
+            if (!HasNative(assemblyDir, chosen))
+            {
+                chosen = chosen == Build.Gpu ? Build.DirectMl : Build.Gpu;
+                if (!HasNative(assemblyDir, chosen))
+                    chosen = preferred; // neither shipped here: leave the default probing alone
+                else
+                    Log.Info($"[ONNX] The {Describe(preferred)} build is not shipped next to {Path.GetFileName(ortAssembly.Location)}, using {Describe(chosen)}");
+            }
+
+            try
+            {
+                var folder = Path.Combine(assemblyDir, chosen == Build.Gpu ? GpuFolder : DirectMlFolder);
+                NativeLibrary.SetDllImportResolver(ortAssembly, (name, _, _) => Resolve(name, folder));
+            }
+            catch (InvalidOperationException)
+            {
+                // A resolver is already set for this assembly: the default probing stays in charge
+            }
+
+            Selected[ortAssembly] = chosen;
+            return chosen;
+        }
+    }
+
+    public static string Describe(Build build) => build == Build.Gpu ? "CUDA" : "DirectML";
+
+    private static bool HasNative(string assemblyDir, Build build)
+        => File.Exists(Path.Combine(assemblyDir, build == Build.Gpu ? GpuFolder : DirectMlFolder, "onnxruntime.dll"));
+
+    private static IntPtr Resolve(string libraryName, string folder)
+    {
+        if (!libraryName.StartsWith("onnxruntime", StringComparison.OrdinalIgnoreCase))
+            return IntPtr.Zero;
+
+        // The DirectML runtime beside the build is preferred over a (possibly older) system DirectML.dll
+        var directMl = Path.Combine(folder, "DirectML.dll");
+        if (File.Exists(directMl))
+            NativeLibrary.TryLoad(directMl, out _);
+
+        var file = Path.Combine(folder, libraryName.EndsWith(".dll", StringComparison.OrdinalIgnoreCase) ? libraryName : libraryName + ".dll");
+        return File.Exists(file) && NativeLibrary.TryLoad(file, out var handle) ? handle : IntPtr.Zero;
+    }
+}
