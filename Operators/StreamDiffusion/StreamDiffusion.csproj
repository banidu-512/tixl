<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(SolutionDir)/Tixl.props" />
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>9ec4b43e-d682-4589-bc4e-4a7619ccef96</UserSecretsId>
    <Configurations>Debug;Release</Configurations>
    <Platforms>AnyCPU</Platforms>
    <VersionPrefix>1.0.0</VersionPrefix>
    <HomeGuid>9a7b3c8d-4e2f-5a6b-7c8d-9e0f1a2b3c4d</HomeGuid>
    <EditorVersion>$(TixlVersion)</EditorVersion>
    <IsEditorOnly>false</IsEditorOnly>
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);0108;9084;NU1900;CS8981</NoWarn>
    <PackageId>9a7b3c8d-4e2f-5a6b-7c8d-9e0f1a2b3c4d</PackageId>
    <RootNamespace>StreamDiffusion</RootNamespace>
    <AssemblyName>$(RootNamespace)</AssemblyName>
    <IsArchived>false</IsArchived>
    <RunAnalyzers Condition="'$(Configuration)' == 'Debug'">false</RunAnalyzers>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <PropertyGroup>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <NoWarn>$(NoWarn);0108;9084;NU1900;CS8981</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <NoWarn>$(NoWarn);0108;9084;NU1900;CS8981</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Numerics" />
    <Using Include="System.Linq" />
    <Using Include="System.Linq.Expressions" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.Collections.Concurrent" />
    <Using Include="System.Diagnostics" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
    <Using Include="System.IO" />
    <Using Include="System.Runtime.InteropServices" />
    <Using Include="System.Text" />
    <Using Include="System.Text.Json" />
    <Using Include="T3.Core.Logging" />
    <Using Include="T3.Core.Operator" />
    <Using Include="T3.Core.Operator.Attributes" />
    <Using Include="T3.Core.Operator.Slots" />
    <Using Include="T3.Core.DataTypes" />
    <Using Include="T3.Core.Operator.Interfaces" />
    <Using Include="T3.Core.Resource" />
    <Using Include="T3.Core.Resource.Assets" />
    <Using Alias="Buffer" Include="SharpDX.Direct3D11.Buffer" />
    <Using Alias="TextureAddressMode" Include="SharpDX.Direct3D11.TextureAddressMode" />
    <Using Alias="Filter" Include="SharpDX.Direct3D11.Filter" />
    <Using Alias="Format" Include="SharpDX.DXGI.Format" />
    <Using Alias="Texture2DDescription" Include="SharpDX.Direct3D11.Texture2DDescription" />
    <Using Alias="ResourceUsage" Include="SharpDX.Direct3D11.ResourceUsage" />
    <Using Alias="BindFlags" Include="SharpDX.Direct3D11.BindFlags" />
    <Using Alias="SampleDescription" Include="SharpDX.DXGI.SampleDescription" />
    <Using Alias="CpuAccessFlags" Include="SharpDX.Direct3D11.CpuAccessFlags" />
    <Using Alias="MapMode" Include="SharpDX.Direct3D11.MapMode" />
    <Using Alias="MapFlags" Include="SharpDX.Direct3D11.MapFlags" />
    <Using Alias="ResourceOptionFlags" Include="SharpDX.Direct3D11.ResourceOptionFlags" />
    <Using Alias="Texture2D" Include="T3.Core.DataTypes.Texture2D" />
    <Using Alias="Vector2" Include="System.Numerics.Vector2" />
    <Using Alias="Vector3" Include="System.Numerics.Vector3" />
    <Using Alias="Vector4" Include="System.Numerics.Vector4" />
    <Using Alias="Int2" Include="T3.Core.DataTypes.Vector.Int2" />
    <Using Alias="ResourceManager" Include="T3.Core.Resource.ResourceManager" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Core/Core.csproj" Private="false" PrivateAssets="all" />
    <ProjectReference Include="../../Logging/Logging.csproj" Private="false" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.20.1" />
  </ItemGroup>
  <!-- Native dependencies -->
  <ItemGroup>
    <Content Include="Assets/**/*" CopyToOutputDirectory="PreserveNewest">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
    <None Remove="Examples/**" />
  </ItemGroup>
  <!-- Package content for distribution -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <PackageAssets Include="Assets/**/*" Exclude="bin/**" />
    <PackageSymbols Include="**/*.t3" Exclude="bin/**" />
    <PackageSymbolUis Include="**/*.t3ui" Exclude="bin/**" />
    <PackageSourceCode Include="**/*.cs" Exclude="bin/**;obj/**" />
    <PackageMeta Include=".meta/**/*" />
  </ItemGroup>
  <Target Name="CopyPackageContent" AfterTargets="AfterBuild" Condition="'$(Configuration)' == 'Release'">
    <Copy SourceFiles="@(PackageAssets)" DestinationFiles="@(PackageAssets->'$(OutputPath)/Assets/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PackageSymbols)" DestinationFiles="@(PackageSymbols->'$(OutputPath)/Symbols/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PackageSymbolUis)" DestinationFiles="@(PackageSymbolUis->'$(OutputPath)/SymbolUis/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PackageMeta)" DestinationFiles="@(PackageMeta->'$(OutputPath)/.meta/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PackageSourceCode)" DestinationFiles="@(PackageSourceCode->'$(OutputPath)/SourceCode/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup>
    <Compile Remove="Examples/**" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Remove="Examples/**" />
  </ItemGroup>
  <Target Name="ClearBuildOutput" BeforeTargets="BeforeBuild">
    <RemoveDir Directories="bin/$(Configuration)" />
  </Target>
  <Target Name="CreatePackageInfo" AfterTargets="AfterBuild">
    <PropertyGroup>
      <RuntimeIdentifier>win-x64</RuntimeIdentifier>
      <OperatorPackageInfoJson>{"HomeGuid":"$(HomeGuid)","PackageId":"$(PackageId)","RootNamespace":"$(RootNamespace)","AssemblyFileName":"$(RootNamespace)","Version":"$(VersionPrefix)","EditorVersion":"$(EditorVersion)","IsEditorOnly":"$(IsEditorOnly)","OperatorPackages":[]}</OperatorPackageInfoJson>
    </PropertyGroup>
    <WriteLinesToFile File="$(OutputPath)/OperatorPackage.json" Lines="$(OperatorPackageInfoJson)" Overwrite="True" Encoding="UTF-8" />
    <WriteLinesToFile File="$(OutDir)/../OperatorPackage.json" Lines="$(OperatorPackageInfoJson)" Overwrite="True" Encoding="UTF-8" />
  </Target>

  <Target Name="CopyDllToBaseDirectory" AfterTargets="AfterBuild">
    <Copy SourceFiles="$(OutputPath)/$(RootNamespace).dll" DestinationFiles="$(OutDir)/../$(RootNamespace).dll" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(OutputPath)/$(RootNamespace).pdb" DestinationFiles="$(OutDir)/../$(RootNamespace).pdb" SkipUnchangedFiles="true" Condition="Exists('$(OutputPath)/$(RootNamespace).pdb')" />
    <!-- ONNX Runtime must sit next to the operator assembly so the editor can resolve it -->
    <Copy SourceFiles="$(OutputPath)/Microsoft.ML.OnnxRuntime.dll" DestinationFiles="$(OutDir)/../Microsoft.ML.OnnxRuntime.dll" SkipUnchangedFiles="true" Condition="Exists('$(OutputPath)/Microsoft.ML.OnnxRuntime.dll')" />
    <Copy SourceFiles="$(OutputPath)/onnxruntime.dll" DestinationFiles="$(OutDir)/../onnxruntime.dll" SkipUnchangedFiles="true" Condition="Exists('$(OutputPath)/onnxruntime.dll')" />
    <Copy SourceFiles="$(OutputPath)/onnxruntime_providers_shared.dll" DestinationFiles="$(OutDir)/../onnxruntime_providers_shared.dll" SkipUnchangedFiles="true" Condition="Exists('$(OutputPath)/onnxruntime_providers_shared.dll')" />
    <Copy SourceFiles="$(OutputPath)/DirectML.dll" DestinationFiles="$(OutDir)/../DirectML.dll" SkipUnchangedFiles="true" Condition="Exists('$(OutputPath)/DirectML.dll')" />
  </Target>
  <!-- The ORT GPU NuGet auto-copies only the core onnxruntime.dll; the CUDA/TRT provider DLLs are
       loaded dynamically at runtime and must sit next to the assembly the editor loads. ClearBuildOutput
       wipes bin/$(Configuration) on every build, so copy them explicitly from the global packages folder
       into the plain (RID-less) output folder the editor resolves. -->
  <Target Name="CopyOrtProviderDlls" AfterTargets="AfterBuild">
    <PropertyGroup>
      <_OrtGpuNative>$(NuGetPackageRoot)microsoft.ml.onnxruntime.gpu.windows\1.20.1\runtimes\win-x64\native</_OrtGpuNative>
      <_OrtBinRoot>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)</_OrtBinRoot>
    </PropertyGroup>
    <Copy SourceFiles="$(_OrtGpuNative)\onnxruntime_providers_cuda.dll" DestinationFiles="$(_OrtBinRoot)\onnxruntime_providers_cuda.dll" SkipUnchangedFiles="true" Condition="Exists('$(_OrtGpuNative)\onnxruntime_providers_cuda.dll')" />
    <Copy SourceFiles="$(_OrtGpuNative)\onnxruntime_providers_tensorrt.dll" DestinationFiles="$(_OrtBinRoot)\onnxruntime_providers_tensorrt.dll" SkipUnchangedFiles="true" Condition="Exists('$(_OrtGpuNative)\onnxruntime_providers_tensorrt.dll')" />
  </Target>
</Project>
