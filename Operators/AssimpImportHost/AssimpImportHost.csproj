<Project Sdk="Microsoft.NET.Sdk">
  <!-- Standalone launcher for isolated Assimp imports and exports outside the editor ([AssimpImport],
       [AssimpExport]). Inside TiXL the editor executable hosts the same worker in host mode and needs
       no dotnet installation; this launcher covers tests and other hosts. It has no dependencies of its
       own: it loads the Lib operator package from the path it gets and runs the operation there, in a
       separate process, so a native crash or hang in Assimp can't affect the caller. Built and copied
       into Lib's output by Lib.csproj. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Run with "dotnet AssimpImportHost.dll": no native apphost, so one build serves every platform -->
    <UseAppHost>false</UseAppHost>
    <RollForward>Major</RollForward>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
