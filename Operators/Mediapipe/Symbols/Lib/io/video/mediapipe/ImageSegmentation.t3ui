        "X": -200.0,
        "Y": 300.0
      },
      "Description": "Comma-separated list of category names to allow (e.g. \"person, cup\").",
      "Usage": "Default"
    },
    {
      "InputId": "a1b2c3d4-0005-4a9b-8c2d-101010101010"/*Acceleration*/,
      "Position": {
        "X": -200.0,
        "Y": 450.0
      },
      "Description": "Inference acceleration: Cpu = plain single-threaded TF Lite (works everywhere), Xnnpack = multithreaded CPU (the fast default), Gpu = OpenGL/EGL delegate (Linux; the Windows/macOS natives are CPU-only and fall back to Cpu)."
    },
    {
      "InputId": "a1b2c3d4-1005-4a9b-8c2d-101010101010"/*InferenceThreads*/,
      "Position": {
        "X": -200.0,
        "Y": 525.0
      },
      "Description": "Worker threads for the Xnnpack acceleration (0 = library default). Ignored by Cpu and Gpu."
    }
],
