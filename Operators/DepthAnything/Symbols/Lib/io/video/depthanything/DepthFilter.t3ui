{
  "FormatVersion": 3,
  "Id": "e2f3a4b5-c6d7-e8f9-a0b1-c2d3e4f5a6b7"/*DepthFilter*/,
  "Description": "Smooths a depth map with an edge-aware bilateral filter.\n\nReduces noise in estimated depth while keeping depth edges sharp.\n\nAKA: bilateral filter, depth smoothing, denoise",
  "InputUis": [
    {
      "InputId": "a2b3c4d5-e6f7-a8b9-c0d1-e2f3a4b5c6d7"/*DepthTexture*/,
      "Position": {
        "X": -250.0,
        "Y": -350.0
      },
      "Description": "The depth map to filter."
    },
    {
      "InputId": "b3c4d5e6-f7a8-b9c0-d1e2-f3a4b5c6d7e8"/*SigmaSpace*/,
      "Position": {
        "X": -250.0,
        "Y": -300.0
      },
      "Description": "Spatial extent of the filter."
    },
    {
      "InputId": "c4d5e6f7-a8b9-c0d1-e2f3-a4b5c6d7e8f9"/*SigmaColor*/,
      "Position": {
        "X": -250.0,
        "Y": -250.0
      },
      "Description": "Depth difference over which neighbors still contribute. Smaller values keep edges sharper."
    },
    {
      "InputId": "d5e6f7a8-b9c0-d1e2-f3a4-b5c6d7e8f9a0"/*Enabled*/,
      "Position": {
        "X": -250.0,
        "Y": -200.0
      },
      "Description": "Passes the depth through unchanged when disabled."
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "f3a4b5c6-d7e8-f9a0-b1c2-d3e4f5a6b7c8"/*FilteredDepth*/,
      "Position": {
        "X": 200.0,
        "Y": -350.0
      }
    }
  ]
}