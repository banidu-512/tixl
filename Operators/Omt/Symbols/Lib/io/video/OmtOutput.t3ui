{
  "FormatVersion": 3,
  "Id": "957ef10e-b410-4eb6-8c2a-b813e8df3a3e"/*OmtOutput*/,
  "Description": "Sends a texture as an Open Media Transport (OMT) video stream on the local network.\n\nReceivers find the stream as MACHINE (SenderName); the SourceAddress output shows that name once the sender is announced. Nothing is read back from the GPU while no receiver is connected. The texture must be B8G8R8A8 or R8G8B8A8 (UNorm or Typeless); [ConvertFormat] or [RenderTarget] can provide one, e.g. [TorusMesh]->[DrawMesh]->[RenderTarget]->[OmtOutput].\n\nTo stream a whole output rather than a single texture, add an OMT stream in the output setup instead.\n\nAKA: Open Media Transport, network video output, NDI alternative\n\nTips\n- Without alpha, frames are packed to UYVY on the GPU, which halves the readback; enable alpha only when the receiver needs it.\n- Receive it with [OmtInput] or any other OMT receiver.",
  "InputUis": [
    {
      "InputId": "a16c8835-4298-43c0-b240-9ab428f6dba9"/*Texture*/,
      "Position": {
        "X": -200.0,
        "Y": 0.0
      }
    },
    {
      "InputId": "852d49b4-a3d9-48b0-a855-d41383f7f95e"/*SenderName*/,
      "Position": {
        "X": -200.0,
        "Y": 90.0
      },
      "Description": "The source name receivers see, after the machine name.",
      "Usage": "Default"
    },
    {
      "InputId": "98e9190e-9cde-45da-bffc-e3c97a528be3"/*FrameRate*/,
      "Position": {
        "X": -200.0,
        "Y": 135.0
      },
      "Description": "Frames per second sent and advertised to receivers. Rendered frames in between are skipped.",
      "Min": 1,
      "Max": 120,
      "ClampMin": true
    },
    {
      "InputId": "e7bbb443-b97e-4446-acb8-10648d65237a"/*EnableAlpha*/,
      "Position": {
        "X": -200.0,
        "Y": 180.0
      },
      "Description": "Sends BGRA with the alpha channel instead of opaque UYVY."
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "cade9b2b-2a82-4028-859e-813f0a763c39"/*TextureOutput*/,
      "Position": {
        "X": 300.0,
        "Y": 200.0
      }
    },
    {
      "OutputId": "fc06d936-aa9d-4e70-af49-acf151cbf3ca"/*SourceAddress*/,
      "Position": {
        "X": 300.0,
        "Y": 250.0
      }
    }
  ]
}