{
  "FormatVersion": 2,
  "TixlVersion": "4.2.0.2",
  "Id": "B2C3D4E5-F6A7-8901-ABCD-EF1234567890"/*PONKInput*/,
  "Description": "Receives laser path frames from any PONK-compliant sender (e.g. MadMapper) via UDP multicast or unicast. Parses the PONK protocol, reassembles chunked frames, converts XY_F32_RGB_U8 and XY_U16_RGB points to TiXL LaserPoint format, and outputs them as a StructuredList. Includes configurable coordinate remapping and sender ID filtering.",
