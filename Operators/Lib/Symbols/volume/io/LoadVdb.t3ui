{
  "FormatVersion": 3,
  "Id": "70b83837-48fa-53ad-8b68-504bceff2848"/*LoadVdb*/,
  "Description": "Loads grids from an OpenVDB file.\n\nReads uncompressed, zip and blosc-compressed data as written by Houdini, Blender or TiXL. Float grids become the primary data of the volume; vector grids such as velocity or color ride along in the same set. The file is reloaded when it changes and the operator is evaluated.\n\nAKA: import vdb, read openvdb\n\nTips\n- Leave GridName empty to load every supported grid.",
  "InputUis": [
    {
      "InputId": "1e3dcc23-489a-5a54-b1af-c04d85ac3b8a"/*GridName*/,
      "Position": {
        "X": 0.0,
        "Y": -30.0
      },
      "Description": "Load only the grid with this name. Empty loads all supported grids.",
      "Usage": "Default"
    },
    {
      "InputId": "e16c0dad-a228-5a6f-964b-82986746836e"/*Path*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      },
      "Description": "File path of the .vdb file.",
      "Usage": "Default"
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "f25cded9-8ca1-5431-9399-8d1285e00703"/*Volume*/,
      "Position": {
        "X": 300.0,
        "Y": 0.0
      },
      "Description": "The loaded volume, or empty when the file is missing or unreadable."
    }
  ]
}
