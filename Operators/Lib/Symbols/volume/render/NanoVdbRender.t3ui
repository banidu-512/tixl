      "InputId": "76f6689f-4b17-5daa-b078-1f2a176c7f03",
      "Position": {
        "X": 0.0,
        "Y": 240.0
      },
      "Description": "Raymarch steps across the box. Higher is smoother and slower."
    },
    {
      "InputId": "9e36533d-0334-5aab-880b-7799fbd6bffa",
      "Position": {
        "X": 0.0,
        "Y": 280.0
      },
      "Description": "Direction towards the light."
