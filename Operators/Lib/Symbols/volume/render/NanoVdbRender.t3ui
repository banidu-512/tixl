    },
    {
      "InputId": "f115a2e9-1fa8-5f78-983a-6bb8bd6b61bf",
      "Position": {
        "X": 0.0,
        "Y": 200.0
      },
      "Description": "Drives the scrolling of the procedural smoke and flame detail."
    },
