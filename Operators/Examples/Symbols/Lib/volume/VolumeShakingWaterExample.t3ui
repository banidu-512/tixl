      "Position": {
        "X": 940.0,
        "Y": 610.0
      }
    },
    {
      "ChildId": "f4a23355-00ad-518e-b164-f2f08ebced52",
      "SymbolName": "Lib.render.transform.Group",
      "SectionId": "b672c2e4-e523-5b54-8289-acd3e4d51c5d",
      "Comment": "OrbitCamera.Command takes a single command, so both shake groups are combined here: Group.Commands is a multi-input.",
      "Position": {
        "X": 1760.0,
        "Y": 300.0
      }
    }
