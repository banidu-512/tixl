{
  "FormatVersion": 3,
  "Id": "37449751-31a8-5ead-9525-88759fdfd1b0"/*VolumeShakingWaterExample*/,
  "Description": "Shaking water in an open box: a box minus a slightly smaller box gives a hollow, open-topped container. The water is a [VolumeNoise] displaced level set clipped to the cavity and drawn as a surface. Two [OscillateVec3] nodes do the shaking - one translates the container, one tilts the water with a slower phase so the liquid lags behind the box. They run on the idle-motion clock, so it animates without pressing Play; drag their Amplitude/Period inputs to change the shake.",
  "InputUis": [],
  "SymbolChildUis": [
    {
      "ChildId": "08da8260-6549-5b31-bbeb-e3477742de41",
      "SymbolName": "Lib.volume.generate.VolumePrimitive",
      "SectionId": "8228052a-2fab-5daa-b647-04b9e80fb8d2",
      "Comment": "The outside of the container.",
      "Position": {
        "X": 60.0,
        "Y": 130.0
      }
    },
    {
      "ChildId": "11004a87-290e-5ee2-9637-de8347f2af48",
      "SymbolName": "Lib.geometry.GeometryToMesh",
      "SectionId": "b672c2e4-e523-5b54-8289-acd3e4d51c5d",
      "Comment": "Uploads a mesh to the GPU as a drawable buffer.",
      "Position": {
        "X": 660.0,
        "Y": 240.0
      }
    },
    {
      "ChildId": "3c1c7a98-5be5-52c8-bb5b-df08c093595b",
      "SymbolName": "Lib.volume.generate.VolumePrimitive",
      "Comment": "Same inner cavity, used to clip the water.",
      "Position": {
        "X": 660.0,
        "Y": 900.0
      }
    },
    {
      "ChildId": "42622f50-febe-5bdd-9e52-a37812ec1f3a",
      "SymbolName": "Lib.render.transform.Group",
      "SectionId": "b672c2e4-e523-5b54-8289-acd3e4d51c5d",
      "Comment": "Applies the BoxShake translation to the container mesh only, at draw time - the volume is not rebuilt, so the shake costs nothing.",
      "Position": {
        "X": 1180.0,
        "Y": 300.0
      }
    },
    {
      "ChildId": "430d2878-7951-514d-a5d1-a2bdd973f3a1",
      "SymbolName": "Lib.volume.modify.VolumeCsg",
      "SectionId": "b672c2e4-e523-5b54-8289-acd3e4d51c5d",
      "Comment": "Intersection with the inner box keeps the water inside the walls.",
      "Position": {
        "X": 660.0,
        "Y": 610.0
      }
    },
    {
      "ChildId": "4a60b9c4-fe80-5357-8d0c-c84cb9a3956d",
      "SymbolName": "Lib.image.generate.basic.RenderTarget",
      "Comment": "Renders the command stream into an image.",
      "Position": {
        "X": 2240.0,
        "Y": 300.0
      }
    },
    {
      "ChildId": "4c87d71f-fe39-5403-99d1-0d275719b1b4",
      "SymbolName": "Lib.numbers.anim.animators.OscillateVec3",
      "SectionId": "9174ec11-c941-520a-b40c-7844c56b9690",
      "Comment": "World-space jitter for the container. Amplitude is in meters, Period in seconds-ish (bars). It animates on its own - no Play needed.",
      "Position": {
        "X": 60.0,
        "Y": 430.0
      }
    },
    {
      "ChildId": "63e771ca-4707-58ef-842a-0c577c237326",
      "SymbolName": "Lib.render.camera.OrbitCamera",
      "SectionId": "b672c2e4-e523-5b54-8289-acd3e4d51c5d",
      "Comment": "Camera that orbits its target.",
      "Position": {
        "X": 2000.0,
        "Y": 300.0
      }
    },
    {
      "ChildId": "6e6754ea-ba8b-512b-af9c-4e0450090d4f",
      "SymbolName": "Lib.volume.convert.VolumeToMesh",
      "SectionId": "8228052a-2fab-5daa-b647-04b9e80fb8d2",
      "Comment": "Draw the container as a surface so the water reads against it.",
      "Position": {
        "X": 380.0,
        "Y": 240.0
      }
    },
    {
      "ChildId": "7402bdc5-aacb-55e0-a233-b00b2101d5d4",
      "SymbolName": "Lib.geometry.GeometryToMesh",
      "SectionId": "23901332-a70a-5274-96e4-55f4a86c1582",
      "Comment": "Uploads the water mesh to the GPU.",
      "Position": {
        "X": 1200.0,
        "Y": 610.0
      }
    },
    {
      "ChildId": "7f8226c5-07be-5b63-8891-bdfb1fdf4e3e",
      "SymbolName": "Lib.numbers.anim.animators.OscillateVec3",
      "SectionId": "9174ec11-c941-520a-b40c-7844c56b9690",
      "Comment": "Tilts the water surface by a degree or two, slower than the box, so it lags and slops instead of moving rigidly with the container.",
      "Position": {
        "X": 60.0,
        "Y": 700.0
      }
    },
    {
      "ChildId": "8918d77d-ff2d-56ae-8bbf-367dce386a51",
      "SymbolName": "Lib.mesh.draw.DrawMeshUnlit",
      "SectionId": "23901332-a70a-5274-96e4-55f4a86c1582",
      "Comment": "Draws the water surface in blue.",
      "Position": {
        "X": 1460.0,
        "Y": 610.0
      }
    },
    {
      "ChildId": "a12c3236-2bb8-5f9b-a5d5-d92e62585bdc",
      "SymbolName": "Lib.render.transform.Group",
      "SectionId": "23901332-a70a-5274-96e4-55f4a86c1582",
      "Comment": "Applies the WaterSlosh tilt to the water mesh only.",
      "Position": {
        "X": 1500.0,
        "Y": 860.0
      }
    },
    {
      "ChildId": "a6f4424b-50b9-5e8c-8e8c-60e295e8203d",
      "SymbolName": "Lib.volume.modify.VolumeCsg",
      "SectionId": "8228052a-2fab-5daa-b647-04b9e80fb8d2",
      "Comment": "Difference: outer minus inner = open box.",
      "Position": {
        "X": 380.0,
        "Y": 240.0
      }
    },
    {
      "ChildId": "acc1ef1a-04dd-5541-b255-5407522b029e",
      "SymbolName": "Lib.mesh.draw.DrawMeshUnlit",
      "SectionId": "b672c2e4-e523-5b54-8289-acd3e4d51c5d",
      "Comment": "Draws a mesh with a flat colour.",
      "Position": {
        "X": 920.0,
        "Y": 240.0
      }
    },
    {
      "ChildId": "b4709138-7ea5-5209-a76a-eefee36858e5",
      "SymbolName": "Lib.volume.modify.VolumeNoise",
      "SectionId": "8f94d0b2-14b3-581b-bfb2-829b8b907634",
      "Comment": "Mode 2 = Displace. Time-driven Offset animates the displacement.",
      "Position": {
        "X": 380.0,
        "Y": 610.0
      }
    },
    {
      "ChildId": "c1c3fb47-8c8c-5f61-9bc6-11b20d981b8e",
      "SymbolName": "Lib.volume.generate.VolumePrimitive",
      "SectionId": "8228052a-2fab-5daa-b647-04b9e80fb8d2",
      "Comment": "Lifted on Y so the top stays open - subtracting it leaves four walls and a floor.",
      "Position": {
        "X": 60.0,
        "Y": 360.0
      }
    },
    {
      "ChildId": "dfeaf8e9-1b77-54c8-983d-0a157707a406",
      "SymbolName": "Lib.volume.generate.VolumePrimitive",
      "SectionId": "9174ec11-c941-520a-b40c-7844c56b9690",
      "Comment": "A block of water sitting inside the box. Its surface sits above the floor so it stays visible over the front wall.",
      "Position": {
        "X": 60.0,
        "Y": 610.0
      }
    },
    {
      "ChildId": "ec2afad0-2a6b-5662-9c3e-c9fd2b00dc6e",
      "SymbolName": "Lib.volume.convert.VolumeToMesh",
      "SectionId": "23901332-a70a-5274-96e4-55f4a86c1582",
