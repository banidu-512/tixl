{
  "FormatVersion": 3,
  "Id": "7a25f962-a800-49a0-9394-cf03f6742661"/*CsvToPointsExample*/,
  "Description": "Loads a CSV file and renders its columns as points.\n\nEvery point attribute is read from a named column: Position X/Y/Z, rotation around Z, a uniform scale for all three axes, RGBA color in 0..255 and the radial phase mapped to F1. The sample dataset is a 21×21 ripple with per-point color and size; the points are drawn into a render target so the example can be used like any other image source.\n\nTry changing CsvFile to your own file, or open the operator's parameter panel and pick different columns in the mapping dropdowns.",
  "SymbolTags": "2",
  "InputUis": [
    {
      "InputId": "2e752c92-5a39-4d39-ba43-a8ab2be81c6d"/*CsvFile*/,
      "Position": {
        "X": -750.0,
        "Y": -100.0
      },
      "Description": "CSV file to load. Its first row supplies the column names used by the mapping dropdowns.",
      "Usage": "FilePath",
      "FileFilter": "csv"
    }
  ],
