<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="$(SolutionDir)/Tixl.props" />
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!-- Plain net10.0 on purpose: the relay is pure sockets and must build/run on Linux
             and macOS servers where no windows targeting pack is installed. -->
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>T3.CollabRelay</RootNamespace>
        <AssemblyName>TiXLCollabRelay</AssemblyName>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>
</Project>
